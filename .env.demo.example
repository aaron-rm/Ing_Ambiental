# Copie este archivo como .env.demo y complete los valores reales.
# .env.demo NO se versiona: contiene rutas y secretos locales.

DB_URL=jdbc:postgresql://localhost:5432/alerta_inundaciones
DB_USERNAME=postgres
DB_PASSWORD=cambie-esta-contrasena

# Token usado por la consola y los endpoints administrativos.
# La consola lo lee del entorno; no se escribe en la PWA.
ALERTA_ADMIN_TOKEN=cambie-este-token-largo

# Consola de demostracion (opcional).
ALERTA_API_BASE_URL=http://localhost:8081
ALERTA_DEMO_CONSOLA_HABILITADA=true

# Credenciales administrativas de Firebase (ruta absoluta al JSON).
FIREBASE_CREDENTIALS_PATH=C:\ruta\segura\service-account.json

# Datos publicos de la app web de Firebase.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_VAPID_KEY=
