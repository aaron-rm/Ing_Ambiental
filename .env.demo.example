# Copie este archivo como .env.demo y complete los valores reales.
# .env.demo NO se versiona: contiene rutas y secretos locales.

DB_URL=jdbc:postgresql://localhost:5432/alerta_inundaciones
DB_USERNAME=postgres
DB_PASSWORD=cambie-esta-contrasena

# Token heredado usado por la consola para endpoints administrativos.
# Se retirara cuando la consola termine de migrar a JWT.
ALERTA_ADMIN_TOKEN=cambie-este-token-largo

# Autenticacion JWT: use un secreto largo y distinto en cada entorno.
ALERTA_JWT_SECRET=cambie-este-secreto-de-al-menos-32-caracteres
ALERTA_JWT_EXPIRACION_HORAS=24

# Cuenta administradora inicial.
# Para desarrollo local se utiliza por convencion: admin-local-clave
# En produccion DEBE cambiarse o gestionarse de forma segura mediante secretos.
ALERTA_ADMIN_IDENTIFICADOR=admin
ALERTA_ADMIN_PASSWORD=admin-local-clave

# Origenes o patrones permitidos para CORS, separados por coma.
# Si usa un tunel (Cloudflare, ngrok), agregue su URL HTTPS exacta o un patron
# como https://*.trycloudflare.com (solo para la demo; en produccion use
# origenes exactos). Sin esto, el login y los POST desde el celular responden 403.
ALERTA_CORS_ORIGENES=http://localhost:3000,http://localhost:5173,http://localhost:8081,http://127.0.0.1:8081

# Consola de demostracion (opcional).
ALERTA_API_BASE_URL=http://localhost:8081
ALERTA_DEMO_CONSOLA_HABILITADA=true

# Cache en memoria de GEOGloWS (minutos). Si la API falla, se reutiliza la
# ultima respuesta cacheada aunque haya expirado.
GEOGLOWS_CACHE_MINUTOS=15

# Credenciales administrativas de Firebase (ruta absoluta al JSON).
FIREBASE_CREDENTIALS_PATH=C:\ruta\segura\service-account.json

# Datos publicos de la app web de Firebase.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_VAPID_KEY=
